  _coupons:
  - _type: "\u041F\u0420\u041E\u041C\u041E\u041A\u041E\u0414"
    _mainText: "-30% \u0441\u043A\u0438\u0434\u043A\u0430"
    _additionalText: "\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430
      \u0437\u0430\u043A\u0430\u0437 \u043E\u0442 5 000 \u0420"
    _price: 150
  - _type: "\u041F\u0420\u041E\u0411\u041D\u0418\u041A"
    _mainText: "5 \u0446\u0432\u0435\u0442\u043E\u0432 \u043F\u043E\u043C\u0430\u0434\u044B"
    _additionalText: "\u043D\u0430 \u0432\u044B\u0431\u043E\u0440 \u0438\u0437 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0430"
    _price: 100
  - _type: "\u041F\u0420\u041E\u041C\u041E\u041A\u041E\u0414"
    _mainText: "-15% \u043D\u0430 \u0443\u0445\u043E\u0434"
    _additionalText: "\u0434\u043B\u044F \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0437\u0430\u043A\u0430\u0437\u0430"
    _price: 200
  _defaultBackgroundColor: {r: 0.36862746, g: 0.25490198, b: 0.16862746, a: 1}
  _makeupDurationSeconds: 150
  _makeupThemes:
  - _title: Icy bimbo winter
    _description: "\u0421\u043E\u0437\u0434\u0430\u0439 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439,
      \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0439 \u043E\u0431\u0440\u0430\u0437
      \u0437\u0438\u043C\u043D\u0435\u0439 \u0434\u0438\u0432\u044B! \u0422\u0432\u043E\u044F
      \u0446\u0435\u043B\u044C \u2014 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C
      \u043C\u043E\u0434\u0435\u043B\u044C \u0432 \u043B\u0435\u0434\u044F\u043D\u0443\u044E
      \u043A\u0443\u043A\u043E\u043B\u043A\u0443!"
  - _title: Cherry velvet night
    _description: "\u0421\u043E\u0431\u0435\u0440\u0438 \u0441\u043C\u0435\u043B\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u043E\u0431\u0440\u0430\u0437
      \u0441 \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u044B\u043C\u0438 \u0432\u0438\u0448\u043D\u0451\u0432\u044B\u043C\u0438
      \u043E\u0442\u0442\u0435\u043D\u043A\u0430\u043C\u0438! \u041F\u0443\u0441\u0442\u044C
      \u0433\u0443\u0431\u044B \u0438 \u0432\u043E\u043B\u043E\u0441\u044B \u0441\u0438\u044F\u044E\u0442
      \u0441\u0442\u0440\u0430\u0441\u0442\u044C\u044E!"
  - _title: Pink bubble dream
    _description: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0438\u0433\u0440\u0438\u0432\u044B\u0439
      \u043C\u0430\u043A\u0438\u044F\u0436 \u0432 \u043D\u0435\u0436\u043D\u043E-\u0440\u043E\u0437\u043E\u0432\u044B\u0445
      \u0442\u043E\u043D\u0430\u0445! \u0421\u043E\u0437\u0434\u0430\u0439 \u043E\u0431\u0440\u0430\u0437
      \u0441\u043B\u0430\u0434\u043A\u043E\u0439 \u0438 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u043D\u043E\u0439
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B!"
  - _title: Emerald forest fairy
    _description: "\u0417\u0435\u043B\u0451\u043D\u044B\u0435 \u0438 \u0438\u0437\u0443\u043C\u0440\u0443\u0434\u043D\u044B\u0435
      \u043E\u0442\u0442\u0435\u043D\u043A\u0438 \u0434\u043B\u044F \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u043E\u0433\u043E
      \u043E\u0431\u0440\u0430\u0437\u0430! \u0422\u0432\u043E\u044F \u0446\u0435\u043B\u044C
      \u2014 \u043C\u0430\u043A\u0438\u044F\u0436 \u0442\u0430\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043B\u0435\u0441\u043D\u043E\u0439 \u0444\u0435\u0438!"
